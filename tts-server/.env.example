# SA Maps voice server configuration. Copy to .env (setup-vps.sh does this for you).
# Every variable is optional. Values shown are the recommended settings; where the built-in
# default differs it is noted ("code default").

# --- Deployment (docker-compose + Caddy) ---------------------------------------------
# Public hostname Caddy gets an HTTPS certificate for. Its DNS must point at this server.
# setup-vps.sh fills in <a-b-c-d>.sslip.io (your public IPv4) when you don't pass a domain.
TTS_DOMAIN=

# --- HTTP ----------------------------------------------------------------------------
# Listen port (docker-compose pins 8787 inside the container).
# PORT=8787
# Comma-separated browser origins allowed to call the API (CORS); "*" allows any (code default).
# Browser requests from other origins get 403.
# Requests without an Origin header (the Android app's native player, curl) always work.
#   https://charbelat.github.io             -> the web app on GitHub Pages
#   https://appassets.androidplatform.net   -> the web UI inside the Android app's WebView
# Add e.g. http://localhost:8080 if you test the web app from a local dev server.
ALLOWED_ORIGINS=https://charbelat.github.io,https://appassets.androidplatform.net
# Behind a reverse proxy: take the client IP for rate limiting from X-Forwarded-For.
# docker-compose.yml sets this to 1 for you. Leave at 0 when the server is exposed directly.
TRUST_PROXY=0

# --- Model ---------------------------------------------------------------------------
# Kokoro-82M ONNX precision: q8 (92 MB file, code default) or fp32 (326 MB). Downloaded from
# Hugging Face (onnx-community/Kokoro-82M-v1.0-ONNX) on first start.
# Measured on a 10-core laptop CPU (i7-13620H): fp32 renders a 12-word line in ~1.0 s (real-time factor
# 0.22) against ~3.3 s for q8 (0.73). fp32 is recommended unless the VPS is short on RAM:
# process RSS is ~0.6 GB idle / ~1.0 GB peak with fp32, ~0.33 / ~0.65 GB with q8.
MODEL_DTYPE=fp32
# Where model files are downloaded/cached. Local runs only: Docker always uses /data/models.
# MODEL_DIR=./models

# --- Casting (stock Kokoro voices; see CASTING.md, GET /voices for all ids) -------------
# speed: tempo (1 = normal). pitch: <1 lowers the voice by playing the clip at a lower
# sample rate while tempo is preserved (rendered at speed/pitch). Ranges: speed 0.5-2,
# pitch 0.75-1.25.
CJ_VOICE=am_fenrir
CJ_SPEED=1.05
CJ_PITCH=1.0
SMOKE_VOICE=am_michael
SMOKE_SPEED=0.92
SMOKE_PITCH=0.92

# --- Caching -------------------------------------------------------------------------
# Rendered clips kept in memory (LRU, ~100-200 KB each).
CACHE_ENTRIES=500
# Disk cache of rendered clips (<dir>/<sha1>.wav). Empty value disables it.
# Local runs only: Docker always uses /data/cache.
# CACHE_DIR=./cache
# Oldest disk-cache files are pruned beyond this size.
CACHE_DISK_MAX_MB=2048

# --- Limits --------------------------------------------------------------------------
# Max characters per phrase (longer text is cut at a word boundary; X-Text-Truncated: 1).
MAX_TEXT=280
# New (uncached) phrases per client IP per minute; cached clips are never limited. 0 = off.
RATE_LIMIT_PER_MIN=40
# Max syntheses waiting in the one-at-a-time render queue before answering 503.
MAX_QUEUE=64
