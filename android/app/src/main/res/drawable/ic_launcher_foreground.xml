<?xml version="1.0" encoding="utf-8"?>
<!-- SA Maps launcher foreground: radar disc (black ring, olive map), player arrow, yellow blip.
     108x108 adaptive canvas; everything sits inside the 66dp safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Black outer ring -->
    <path
        android:fillColor="#FF000000"
        android:pathData="M54,22 a32,32 0 1,1 0,64 a32,32 0 1,1 0,-64 Z" />

    <!-- Olive map disc with a few roads, clipped to the radar circle -->
    <group>
        <clip-path android:pathData="M54,26.5 a27.5,27.5 0 1,1 0,55 a27.5,27.5 0 1,1 0,-55 Z" />
        <path
            android:fillColor="#FF6F7A3C"
            android:pathData="M20,20 H88 V88 H20 Z" />
        <!-- darker blocks -->
        <path
            android:fillColor="#FF5C6631"
            android:pathData="M30,30 H47 V47 H30 Z M61,58 H80 V80 H61 Z M30,58 H47 V72 H30 Z" />
        <!-- roads -->
        <path
            android:fillColor="#FFA9A98A"
            android:pathData="M20,50.5 H88 V55 H20 Z M50,20 H54.5 V88 H50 Z M64,20 L68,20 L88,44 L88,49 Z" />
        <!-- water corner -->
        <path
            android:fillColor="#FF3E5F73"
            android:pathData="M66,20 H88 V40 C80,38 72,30 66,20 Z" />
    </group>

    <!-- Thin highlight ring -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF2A2A2A"
        android:strokeWidth="1"
        android:pathData="M54,26.5 a27.5,27.5 0 1,1 0,55 a27.5,27.5 0 1,1 0,-55 Z" />

    <!-- White player arrow -->
    <path
        android:fillColor="#FFFFFFFF"
        android:strokeColor="#FF000000"
        android:strokeWidth="1.5"
        android:strokeLineJoin="round"
        android:pathData="M54,39 L63.5,66 L54,60.5 L44.5,66 Z" />

    <!-- Small yellow blip -->
    <path
        android:fillColor="#FFF2CE1B"
        android:strokeColor="#FF000000"
        android:strokeWidth="1.2"
        android:pathData="M67,33 H74 V40 H67 Z" />
</vector>
